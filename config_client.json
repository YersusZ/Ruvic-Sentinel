  "websocket_url": "ws://localhost:8000/ws/colsoft-tools",
  "allow_insecure_ws": true,
  "require_command_signature": true,
  "agent_id": "PC_Linux_Test",
  "signing_public_key": "certs/enrollment/signing.pub",
  "tls_ca_cert": "certs/enrollment/ca.crt",
  "tls_client_cert": "certs/enrollment/agent.crt",
  "tls_client_key": "certs/enrollment/agent.key",
  "heartbeat_interval": 60,
  "policy": {
    "allowed_commands": [],
    "allow_high_risk": false
  },
  "scripts_catalog": {},
  "audit_log_path": "results_logs/agent_audit.jsonl",
  "max_command_rate": 20,
  "auto_update": {},
  "telemetry_buffer": {
    "max_age_days": 7.0,
    "max_file_bytes": 8388608,
    "max_total_bytes": 1073741824
  },
  "tamper": {
    "allow_rebaseline": true
  },
  "scheduler": {
    "interval_seconds": 60,
    "tools": [
      { "tool": "system_metrics", "params": { "cpu_interval": 0.2 }, "timeout": 20 },
      { "tool": "health_probes", "timeout": 30 },
      { "tool": "linux_systemd_units", "timeout": 20 }
    ]
  },
  "data_plane": {
    "enabled": true,
    "compression": "gzip",
    "batch_size": 32,
    "batch_interval_seconds": 5
  },
  "process_watch": {
    "enabled": false
  },
  "service_watch": {
    "enabled": false
  },
  "health_probes": {
    "interval_seconds": 60,
    "checks": [
      { "id": "server_status", "type": "http", "url": "http://127.0.0.1:8000/health", "timeout": 5 }
    ]
  },
  "alerts": {
    "enabled": true,
    "interval_seconds": 30,
    "cooldown_seconds": 300,
    "rules": [
      { "id": "high_cpu", "metric": "cpu.percent", "op": "gt", "threshold": 90, "severity": "warning" },
      { "id": "disk_full", "metric": "disks.percent.max", "op": "gte", "threshold": 90, "severity": "error" }
    ]
  },
  "security": {
    "fim": { "enabled": false, "interval_seconds": 60 },
    "persistence": { "enabled": false, "interval_seconds": 120 },
    "auth_audit": { "enabled": false, "interval_seconds": 30 },
    "detection": { "enabled": false, "interval_seconds": 5, "max_events_per_tick": 20 },
    "dns": { "enabled": false, "interval_seconds": 15 },
    "rootkit": { "enabled": false, "interval_seconds": 300 },
    "cis": { "enabled": false, "interval_seconds": 3600 },
    "cve_inventory": { "enabled": false, "interval_seconds": 86400 },
    "auto_response": { "enabled": false, "actions": [] }
  },
  "windows": {
    "event_log": { "enabled": false, "interval_seconds": 60, "max_events_per_tick": 40 },
    "autoruns": { "enabled": false, "interval_seconds": 300 },
    "sysmon": { "enabled": false, "interval_seconds": 60 }
  },
  "linux": {
    "auditd": { "enabled": false, "interval_seconds": 60, "max_events_per_tick": 40 },
    "systemd": { "enabled": false, "interval_seconds": 300 },
    "netlink": { "enabled": false, "interval_seconds": 15 }
  }
}
