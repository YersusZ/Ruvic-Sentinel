# Robin: ingress termina TLS en :8444 → pod HTTP :8000.
# Copiar estas variables al panel de Robin (NO commitear secretos reales).
# NO definir SSL_CERTFILE / SSL_KEYFILE / SSL_CA_CERTS / SSL_CERT_REQS.

HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

SERVER_SIGNING_KEY=/certs/signing.key

ALLOW_HIGH_RISK_COMMANDS=
RATE_LIMIT_COMMAND_PER_MIN=10
RATE_LIMIT_AGENT_PER_MIN=30
SERVER_HEARTBEAT_INTERVAL=30
COMMAND_TTL_SECONDS=30

ENROLLMENT_BOOTSTRAP_PORT=0

# CA de enrollment: montar en el pod (secret/volume), NO en la imagen Docker.
# Volúmenes Robin:
#   ./certs/server/ca.key  → /certs/enrollment/ca.key  (ro)
#   ./certs/server/ca.crt  → /certs/enrollment/ca.crt  (ro)
#   ./results_logs         → /app/server/results_logs
ENROLLMENT_CA_KEY=/certs/enrollment/ca.key
ENROLLMENT_CA_CERT=/certs/enrollment/ca.crt
ENROLLMENT_PUBLIC_HOST=
ENROLLMENT_WS_URL=wss://{host}/ws/colsoft-tools

# Tokens de enrollment: JSONL persistente (mint JWT → append automático).
# Montar results_logs/ como volumen en Robin para sobrevivir reinicios.
ENROLL_DIR=results_logs
ENROLLMENT_TOKENS_FILE=results_logs/enrollment_tokens.jsonl
ENROLLMENT_TOKENS_AUTO_APPEND=1

ROBIN_LOGGER_URL=https://logs.robin-ai.xyz/api/robin-logger/store
ROBIN_LOGGER_QUERY_URL=https://logs.robin-ai.xyz/api/logs
# ROBIN_LOGGER_API_KEY=

ROBIN_JWT_REQUIRED=1
ROBIN_API_URL=https://back.robin-ai.xyz/api
# ROBIN_JWT_ISSUER=https://back.robin-ai.xyz
ROBIN_JWT_EXECUTE_ROLES=admin,operator,analyst,soc,gestor
ROBIN_JWT_HIGH_RISK_ROLES=admin,soc,operator

MYSQL_DISABLED=0
MYSQL_HOST=agentes.ctgy4w0oesjd.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306
# MYSQL_USER= y MYSQL_PASSWORD= en el panel de Robin (no dejar vacíos en el pod).
MYSQL_DATABASE=agentes
